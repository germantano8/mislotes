# ==============================================================================
# Variables de Entorno para Docker Compose (Producción en Azure VM)
# ==============================================================================

# Nombre base de los contenedores (mislotes en prod, mislotes_dev en dev)
APP_NAME=mislotes

# Puerto HTTP en el que escuchará Nginx (por defecto 80)
PORT_HTTP=80

# Credenciales de PostgreSQL
DB_USER=admin
DB_PASSWORD=cambiar_esta_clave_segura_123
DB_NAME=mislotes

# Azure Blob Storage (Opcional: Si se deja vacío, guarda en el volumen ./uploads de Docker)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=uploads
